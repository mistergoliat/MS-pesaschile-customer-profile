PORT=3010

CRM_DB_HOST=
CRM_DB_PORT=3306
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_NAME=main_management
CRM_DB_CONNECTION_LIMIT=5
CRM_DB_QUERY_TIMEOUT_MS=3000

PRESTASHOP_DB_HOST=
PRESTASHOP_DB_PORT=3306
PRESTASHOP_DB_USER=
PRESTASHOP_DB_PASSWORD=
PRESTASHOP_DB_NAME=pesas_productiva
PRESTASHOP_DB_PREFIX=ps_
PRESTASHOP_DB_CONNECTION_LIMIT=5
PRESTASHOP_DB_QUERY_TIMEOUT_MS=3000

# RFM is an optional HTTP capability (see CP-R1-TRACK-A-A1A2-rfm-customerid-optional-runtime.md):
# leave every RFM_SNAPSHOT_DB_* variable below unset and the HTTP server still boots — the
# five endpoints above and GET /v1/customers/:customerId/rfm both work; only /rfm degrades to
# 503 { status: 'degraded', reason: 'rfm_not_configured' }. HOST/USER/PASSWORD/NAME are
# enforced all-or-nothing at startup: setting only some of them fails fast, not silently.
#
# The snapshot CLI (npm run snapshot:rfm / snapshot:rfm:scheduled) is a SEPARATE process with
# its own, always-required config (src/rfm-snapshot-config.ts) — outside RFM_DRY_RUN=true, it
# needs the same four fields below PLUS RFM_CALCULATION_VERSION, and fails fast if any are
# missing. This file documents the HTTP server's requirements; the CLI's are a superset.
RFM_SNAPSHOT_DB_HOST=
RFM_SNAPSHOT_DB_PORT=3306
RFM_SNAPSHOT_DB_USER=
RFM_SNAPSHOT_DB_PASSWORD=
RFM_SNAPSHOT_DB_NAME=
# Must stay >= 2 (see rfm-snapshot-config.ts): connectionLimit=1 deadlocks the snapshot CLI
# forever on its first run-log write. Not used by the HTTP server's own connection pattern,
# but shared by the same variable name — do not lower this for either process.
RFM_SNAPSHOT_DB_CONNECTION_LIMIT=5
RFM_SNAPSHOT_DB_QUERY_TIMEOUT_MS=3000

# Snapshot CLI only — not read by the HTTP server. Current value in use (see every
# docs/releases/CP-R1-T11A*.md doc); do not invent a different version.
RFM_CALCULATION_VERSION=rfm-population-v1

CUSTOMER_PROFILE_RECENT_ORDERS_LIMIT=10

# Must match the operational language PesasChile actually uses in PrestaShop
# (ps_order_state_lang.id_lang). Required — no silent default.
PRESTASHOP_ORDER_STATE_LANG_ID=1

# ps_carrier_lang.id_lang / id_shop for reading carrier.delay (CP-R1-T06). Independent
# from PRESTASHOP_ORDER_STATE_LANG_ID by design — both may end up equal in practice, but
# that must be confirmed operationally, not assumed. Required — no silent default.
PRESTASHOP_CARRIER_LANG_ID=1
PRESTASHOP_CARRIER_SHOP_ID=1
